EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_APP_URL=https://gling.ej-entertainment.com
EXPO_PUBLIC_SHARE_URL=https://your-project-ref.supabase.co/functions/v1/public-post
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-app-domain.example
# Google Maps JavaScript + Places (New), restricted to Gling's web origin.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# RevenueCat public SDK keys for the existing Gling project (never a secret API key).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Test ads are the default, including release builds. Set live only for an approved ad rollout.
EXPO_PUBLIC_ADS_MODE=test
# Web AdSense is OFF: account/site approval, a real display unit and a certified web CMP are not ready.
# Enable only after verifying the approved HTTPS origin and disabling Google Auto ads for private app routes.
# CMP_ID must match the installed certified CMP; actual visitor consent is checked at runtime.
EXPO_PUBLIC_ADSENSE_ENABLED=false
EXPO_PUBLIC_ADSENSE_CLIENT=
EXPO_PUBLIC_ADSENSE_SLOT=
EXPO_PUBLIC_ADSENSE_ORIGIN=
EXPO_PUBLIC_ADSENSE_CMP_ID=
# Set only after this EAS project's FCM/APNs credentials are configured and verified.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Absolute path to Gling's Android Firebase config, kept outside this repository.
GLING_GOOGLE_SERVICES_FILE=
