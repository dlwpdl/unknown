{
  "expo": {
    "name": "글링",
    "slug": "gling",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/gling-app-icon.png",
    "scheme": "gling",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/gling-app-icon.png",
      "bundleIdentifier": "com.anonymous.gling"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BE3B2A",
        "foregroundImage": "./assets/brand/gling-mark-light.png",
        "monochromeImage": "./assets/brand/gling-mark-light.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/gling-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진과 게시글 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "게시글 사진을 찍고 AI 초안을 만들기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#BE3B2A",
          "image": "./assets/brand/gling-mark-light.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
