    "android": {
      "package": "com.dlwpdl.gling",
      "versionCode": 67,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/brand/gling-night-wordmark-adaptive.png",
        "monochromeImage": "./assets/brand/gling-night-wordmark-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/gling-night-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#CBB9FF",
          "defaultChannel": "gling-activity"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "With your permission, Google AdMob uses this device's advertising identifier and app activity with other companies' data to measure ads and prevent ad fraud. You can use gling without allowing tracking."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2361293253164911~5342813202",
          "iosAppId": "ca-app-pub-2361293253164911~5982097137",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.326642098269-oa2a97trifhohih9d9tk8lotse14qnn4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진과 게시글 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "게시글 사진을 찍고 AI 초안을 만들기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B12",
          "image": "./assets/brand/transparent-pixel.png",
          "imageWidth": 1
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 도시 추천과 지도 위치 공유를 위해 현재 위치를 한 번 확인합니다. 동의한 도시 추천의 위치 기록은 안전 운영에 사용됩니다.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "글링은 현재 동작 및 피트니스 정보를 요청하거나 수집하지 않습니다. 이 설명은 위치 SDK에 포함된 시스템 기능의 호환성을 위해 제공됩니다.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
