              "host": "gling.ej-entertainment.com",
              "path": "/invite"
            },
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "path": "/meetup-join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 67,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/brand/gling-night-wordmark-adaptive.png",
        "monochromeImage": "./assets/brand/gling-night-wordmark-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/gling-night-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#CBB9FF",
          "defaultChannel": "gling-activity"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "With your permission, Google AdMob uses this device's advertising identifier and app activity with other companies' data to measure ads and prevent ad fraud. You can use gling without allowing tracking."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2361293253164911~5342813202",
          "iosAppId": "ca-app-pub-2361293253164911~5982097137",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.326642098269-oa2a97trifhohih9d9tk8lotse14qnn4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gling uses your photo library so you can add photos to your profile and posts.",
          "cameraPermission": "Gling uses your camera so you can take photos for your posts and AI drafts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B12",
          "image": "./assets/brand/transparent-pixel.png",
          "imageWidth": 1
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gling checks your location once to suggest a nearby city and to share places on the map. If you agree to city suggestions, that location record is also used to keep the community safe.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "Gling doesn't request or collect motion and fitness data. This description is only here because the location SDK includes a related system feature.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
