    "android": {
      "package": "com.dlwpdl.gling",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "pathPrefix": "/posts/"
            },
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "path": "/post"
            },
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "path": "/company"
            },
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "pathPrefix": "/company/"
            },
            {
              "scheme": "https",
              "host": "gling.ej-entertainment.com",
              "path": "/meetups"
            },
            {
