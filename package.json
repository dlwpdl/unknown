{
  "name": "gling",
  "main": "expo-router/entry",
  "version": "1.4.5",
  "dependencies": {
    "@expo/ui": "~58.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~58.0.17",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-tracking-transparency": "~58.0.2",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-purchases": "^10.9.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "admin": "GLING_LOCAL_ADMIN=1 expo export --clear --platform web --output-dir .admin-dist && python3 scripts/serve-admin.py",
    "check:public-web": "node scripts/check-public-web.mjs",
    "storage:usage": "python3 scripts/storage-usage.py",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "GLING_PUBLIC_WEB=1 expo start --web",
    "lint": "expo lint",
    "test:auth": "node --experimental-strip-types --test scripts/kakao-auth.test.mjs",
    "test:admin": "node --experimental-strip-types --test scripts/admin.test.mjs",
    "test:categories": "node --experimental-strip-types --test scripts/categories.test.mjs",
    "test:ai-draft": "node --experimental-strip-types --test scripts/ai-draft.test.mjs",
    "test:onboarding": "node --experimental-strip-types --test scripts/nickname.test.mjs",
    "test:sharing": "node --experimental-strip-types --test scripts/sharing.test.mjs",
    "test:feed": "node --experimental-strip-types --test scripts/feed-data.test.mjs",
    "test:quota": "node --experimental-strip-types --test scripts/membership-screen.test.mjs scripts/membership.test.mjs",
    "test:web-home": "node --experimental-strip-types --test scripts/web-home.test.mjs",
    "typecheck": "tsc --noEmit",
    "export:web": "GLING_LOCAL_ADMIN=0 GLING_MERCHANT_WEB=0 GLING_PUBLIC_WEB=1 expo export --platform web --clear && node scripts/finish-public-web.mjs && npm run export:merchant-web",
    "export:merchant-web": "GLING_PUBLIC_WEB=0 GLING_LOCAL_ADMIN=0 GLING_MERCHANT_WEB=1 GLING_WEB_BASE_URL=/merchant expo export --platform web --output-dir .merchant-dist && node scripts/finish-merchant-web.mjs",
    "check:merchant-web": "node scripts/check-merchant-web.mjs"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "private": true
}
